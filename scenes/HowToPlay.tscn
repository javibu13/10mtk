[node name="GoalDescription_RichTextLabel" type="RichTextLabel" parent="HowToPlayScreen_VBoxContainer/ScrollContainer/HowToPlay_VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 22
theme_override_font_sizes/bold_font_size = 22
bbcode_enabled = true
text = "In 10 minutes to kill, you are a hitman armed with a sniper rifle, a revolver and a knife. Your goal is to kill 3 targets without being discovered. Each time you kill or arrest characters, you earn points. At the end of the game, the winner is the player with the most prestige points.

"
fit_content = true
scroll_active = false
justification_flags = 131

[node name="SetUpTitle_RichTextLabel" type="RichTextLabel" parent="HowToPlayScreen_VBoxContainer/ScrollContainer/HowToPlay_VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 36
theme_override_font_sizes/bold_font_size = 36
bbcode_enabled = true
text = "[b]Set Up[/b]"
fit_content = true
scroll_active = false
autowrap_mode = 0
vertical_alignment = 1

[node name="SetUpDescription_RichTextLabel" type="RichTextLabel" parent="HowToPlayScreen_VBoxContainer/ScrollContainer/HowToPlay_VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 22
theme_override_font_sizes/bold_font_size = 22
bbcode_enabled = true
text = "The 16 tiles are randomly arranged to form the game board.
Each of the 16 characters is placed on a different tile.
Each player is assigned 1 character as the assassin and 3 characters as targets. None of these characters may be repeated during the assignment, so no player can end up targeting another player or any of another player’s targets.
The order of play will be chosen at random.

"
fit_content = true
scroll_active = false
justification_flags = 131

[node name="PlayingTheGameTitle_RichTextLabel" type="RichTextLabel" parent="HowToPlayScreen_VBoxContainer/ScrollContainer/HowToPlay_VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 36
theme_override_font_sizes/bold_font_size = 36
bbcode_enabled = true
text = "[b]Playing The Game[/b]"
fit_content = true
scroll_active = false
autowrap_mode = 0
vertical_alignment = 1

[node name="PlayingTheGameDescription_RichTextLabel" type="RichTextLabel" parent="HowToPlayScreen_VBoxContainer/ScrollContainer/HowToPlay_VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 22
theme_override_font_sizes/bold_font_size = 22
bbcode_enabled = true
text = "On his turn, a player chooses 2 actions among 3:
[ul][b]Move a character[/b] (policemen included) on the board[/ul]
[ul][b]Kill a character[/b][/ul]
[ul][b]Investigate a characters' identity[/b] using a policeman[/ul]
A player may choose the same action twice in the same turn with the exception of Kill a character. A player may only ever kill one character per turn.

"
fit_content = true
scroll_active = false
justification_flags = 131

[node name="MovingTitle_RichTextLabel" type="RichTextLabel" parent="HowToPlayScreen_VBoxContainer/ScrollContainer/HowToPlay_VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 36
theme_override_font_sizes/bold_font_size = 36
bbcode_enabled = true
text = "[b]Moving a Character[/b]"
fit_content = true
scroll_active = false
autowrap_mode = 0
vertical_alignment = 1

[node name="MovingDescription_RichTextLabel" type="RichTextLabel" parent="HowToPlayScreen_VBoxContainer/ScrollContainer/HowToPlay_VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 22
theme_override_font_sizes/bold_font_size = 22
bbcode_enabled = true
text = "A player can move any character on the board he wants, including policemen. To move a character, select it, interact with \"MOVE\" button, select the objective tile and hit the confirm action button.

"
fit_content = true
scroll_active = false
justification_flags = 131

[node name="KillingTitle_RichTextLabel" type="RichTextLabel" parent="HowToPlayScreen_VBoxContainer/ScrollContainer/HowToPlay_VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 36
theme_override_font_sizes/bold_font_size = 36
bbcode_enabled = true
text = "[b]Killing a Character[/b]"
fit_content = true
scroll_active = false
