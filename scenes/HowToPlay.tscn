vertical_alignment = 1

[node name="KillingDescription_RichTextLabel" type="RichTextLabel" parent="HowToPlayScreen_VBoxContainer/ScrollContainer/HowToPlay_VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 22
theme_override_font_sizes/bold_font_size = 22
bbcode_enabled = true
text = "Once per turn, a player may kill a character on the board:
[ul]A character can only be killed with the player’s hitman.[/ul]
[ul]The hitman must use one of the three weapons he’s armed with: either the Revolver, the Sniper rifle, or the Knife (you may use any weapon at each killing).[/ul]
[ul]The hitman must not be seen killing his target.[/ul]
A hitman is seen if:
[ul]He uses the Revolver or the Sniper rifle when another character is on the same tile as his. If the hitman uses the Knife, he is not seen by the non-policeman characters on his tile (see killing with the Knife).[/ul]
[ul]A policeman is on the same tile as the hitman or an adjacent one, even if the hitman uses a Knife (see The Police).[/ul]
A character can be killed even if he’s sharing his tile with another character.
	[b]The Revolver[/b]
The Revolver allows a hitman to kill a character on a tile adjacent to his. [u]The hitman must be alone on his tile to use the Revolver.[/u]
	[b]The Sniper rifle[/b]
The Sniper rifle allows a hitman to kill any character whose location tile is orthogonal to the hitman’s. The Sniper rifle can be used from any distance but may never shoot diagonally. Shooting through empty gaps between location tiles is allowed. Other characters do not block a Sniper rifle’s line-of-sight.
A hitman must be on a location tile with the “target” symbol to use the Sniper rifle. The tiles with this symbol can be identified with their blue-colored edges. [u]The hitman must be alone on his tile to use a Sniper rifle.[/u]
	[b]The Knife[/b]
The Knife allows a hitman to kill any character occupying the same tile as his. Thanks to this weapon’s discreet nature, the Knife can be use even if there are other characters on the tile. The use of a Knife is unnoticeable by other characters except the policemen.

To kill a character, select it, interact with \"KILL\" button and hit the confirm action button.

"
fit_content = true
scroll_active = false
justification_flags = 131

[node name="ConsecuencesTitle_RichTextLabel" type="RichTextLabel" parent="HowToPlayScreen_VBoxContainer/ScrollContainer/HowToPlay_VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 36
theme_override_font_sizes/bold_font_size = 36
bbcode_enabled = true
text = "[b]Consecuences Of a Kill[/b]"
fit_content = true
scroll_active = false
autowrap_mode = 0
vertical_alignment = 1

[node name="ConsecuencesDescription_RichTextLabel" type="RichTextLabel" parent="HowToPlayScreen_VBoxContainer/ScrollContainer/HowToPlay_VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 22
theme_override_font_sizes/bold_font_size = 22
bbcode_enabled = true
text = "When a character is killed, he is removed from the board. If the character was the killer or the target will be revealed in the corresponding player's panel. Afterwards, all characters on the same tile as the victim flee the crime scene. Each of them will be placed on a different tile randomly. Then, a policeman is added to the crime scene tile. If there is no more policeman available, one policeman on the board will be moved to the crime scene tile randomly.

"
fit_content = true
scroll_active = false
justification_flags = 131

[node name="ThePoliceTitle_RichTextLabel" type="RichTextLabel" parent="HowToPlayScreen_VBoxContainer/ScrollContainer/HowToPlay_VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 36
theme_override_font_sizes/bold_font_size = 36
bbcode_enabled = true
text = "[b]The Police[/b]"
fit_content = true
scroll_active = false
autowrap_mode = 0
vertical_alignment = 1

[node name="ThePoliceDescription_RichTextLabel" type="RichTextLabel" parent="HowToPlayScreen_VBoxContainer/ScrollContainer/HowToPlay_VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 22
theme_override_font_sizes/bold_font_size = 22
bbcode_enabled = true
text = "Policemen can be moved like any other character in the game. Any player may move a policeman using the Moving a character action. A policeman is a specific character that always witnesses a hitman’s attempts if he’s occupying the same or directly adjacent tile (no diagonal), even if the hitman uses a Knife!

"
fit_content = true
scroll_active = false
justification_flags = 131

[node name="InvestigateTitle_RichTextLabel" type="RichTextLabel" parent="HowToPlayScreen_VBoxContainer/ScrollContainer/HowToPlay_VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 36
theme_override_font_sizes/bold_font_size = 36
bbcode_enabled = true
text = "[b]Investigate a Character's Identity[/b]"
fit_content = true
scroll_active = false
autowrap_mode = 0
vertical_alignment = 1

[node name="InvestigateDescription_RichTextLabel" type="RichTextLabel" parent="HowToPlayScreen_VBoxContainer/ScrollContainer/HowToPlay_VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 22
theme_override_font_sizes/bold_font_size = 22
bbcode_enabled = true
text = "A player can choose to investigate the identity of a character on the board. Identity checks are performed only by policemen. To check another player’s identity, the policeman must be on the same tile. The player who wishes to check someone’s identity selects a character from the same tile as a policeman and hits the \"INVESTIGATE\" action button. After that, the designated player to be asked can be selected from a drowpdown menu and confirma action button has to be clicked to proceed. If the character is the player’s hitman, he will be revealed and removed from the board.

A player is never eliminated from the game. Even when he has lost his hitman (killed or arrested), the player is still in play and may even win by successfully checking the identity of other players’ hitmen.

"
fit_content = true
scroll_active = false
justification_flags = 131

