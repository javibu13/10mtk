[node name="GoalTitle_RichTextLabel" type="RichTextLabel" parent="HowToPlayScreen_VBoxContainer/ScrollContainer/HowToPlay_VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 36
theme_override_font_sizes/bold_font_size = 36
