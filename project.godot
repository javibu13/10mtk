; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="10' To Kill"
run/main_scene="uid://chyfiqusrxmpw"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

TileRunInstancesGlobal="*res://addons/tile-run-instances/tile_run_instances_global.gd"
DatabaseManager="*res://scripts/autoload/database_manager.gd"
NetworkManager="*res://scripts/autoload/network_manager.gd"
AuthManager="*res://scripts/autoload/auth_manager.gd"
ServerGlobalData="*res://scripts/autoload/server_global_data.gd"
ClientGlobalData="*res://scripts/autoload/client_global_data.gd"
MatchmakingManager="*res://scripts/autoload/matchmaking_manager.gd"

[display]

window/stretch/mode="canvas_items"

[editor]

run/main_run_args="--client --ip 127.0.0.1 --port 2828"
version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-sqlite/plugin.cfg", "res://addons/tile-run-instances/plugin.cfg")

[gui]

common/snap_controls_to_pixels=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
